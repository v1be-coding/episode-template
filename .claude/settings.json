{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f /.dockerenv ] || { echo 'Episodes run only in the dev container (ADR-0012).' >&2; exit 2; }"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guardrails.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "if [ -f /.dockerenv ]; then printf '\\033[30;42m CONTAINER \\033[0m'; else printf '\\033[37;41m WINDOWS: use the V1be Claude episode shortcut \\033[0m'; fi"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge * --auto --squash)",
      "Edit(/docs/**)",
      "Edit(/GLOSSARY.md)",
      "Edit(/CODING_STANDARDS.md)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-tree *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git pull *)",
      "Bash(git hash-object *)",
      "Bash(git clone --depth 1 *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh search *)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npx prettier *)",
      "Bash(npm view *)",
      "Bash(terraform -chdir=infra/* fmt *)",
      "Bash(terraform -chdir=infra/* validate)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(node scripts/gh-read.mjs *)",
      "WebSearch",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:claude.com)",
