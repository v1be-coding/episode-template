{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f /.dockerenv ] || { echo 'Episodes run only in the dev container (ADR-0012).' >&2; exit 2; }"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guardrails.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(gh pr merge * --auto --squash)"]
  }
}
